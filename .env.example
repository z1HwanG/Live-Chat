# 复制为 .env 并填写真实值（部署脚本会自动生成）
# 数据库（PostgreSQL，线上已有 livechat 库，用线上连接信息）
# 注意：web 与 srs 跑在 bridge 网络里，连宿主上的 PG 用 Docker 网关 IP（默认 172.17.0.1），
#       若 PG 也在 docker 网络内，则填其容器名或容器 IP。
DB_USER=livechat
DB_PASSWORD=请修改
DB_HOST=172.17.0.1
DB_PORT=5432
DB_NAME=livechat
# 推流密钥（OBS 推流 URL 里的 token）
PUSH_TOKEN=请修改
# 管理员口令
ADMIN_PASSWORD=请修改
# 公网域名（替换为你的域名，用于生成 RTMP 推流地址）
PUBLIC_HOST=live.example.com
# 站点名
SITE_NAME=我的直播
# 直播流名
STREAM_NAME=stream
# SRS 服务器公网 IP（用于 WebRTC candidate）
SRS_CANDIDATE=127.0.0.1
# Web 服务端口（宿主映射；默认 3010）
PORT=3010
# SRS 端口（宿主映射；标准端口。若与线上其他 SRS 冲突，可改成 1936/1986/8081/8001 等）
RTMP_PORT=1935
SRS_API_PORT=1985
FLV_PORT=8080
RTC_PORT=8000
